# Plantilla de variables de entorno para el frontend (Vite)
# Copia este archivo como .env y ajusta los valores correspondientes a tu backend local o remoto

# URL base de la API del Backend
VITE_API_URL=http://localhost:3000/api

# URL para WebSockets o Server-Sent Events (opcional para tiempo real)
VITE_WS_URL=ws://localhost:3000

# Parámetros por defecto para emular el chat
VITE_DEFAULT_CONVERSATION_ID=A132
VITE_DEFAULT_LEAD_ID=509436
VITE_DEFAULT_BOT_NAME=SalesBot (Salesbot #19)
